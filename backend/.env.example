# # ╔══════════════════════════════════════════════════════════════════════╗
# # ║  Nexora Backend — Environment Variables                            ║
# # ║  Copy this file to .env and fill in the values.                    ║
# # ╚══════════════════════════════════════════════════════════════════════╝

# # ─── Server ───────────────────────────────────────────────────────────
# PORT=5000
# NODE_ENV=development

# # Comma-separated origins allowed by CORS (use * to allow all)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# # ─── Database ─────────────────────────────────────────────────────────
# # MongoDB connection string (local or Atlas)
# MONGO_URI=mongodb://localhost:27017/nexora
# # MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/nexora

# # ─── Authentication ───────────────────────────────────────────────────
# # Firebase Admin SDK — at least one credential source is required for
# # the v1 API (/api/v1/auth/*). Without it, Firebase init falls back to
# # demo/emulator mode and token verification will fail.

# # Option 1: Full service-account JSON string (single line, no newlines)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# # Option 2: Path to a service-account JSON key file
# # GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# # Firebase project ID (used in demo mode when no credentials are set)
# FIREBASE_PROJECT_ID=nexora-dev

# # Legacy JWT secret — used by /api/auth/* routes (legacy auth controller)
# # Only needed if clients still use the legacy JWT-based auth endpoints.
# JWT_SECRET=change-me-to-a-random-string

# # ─── Google Fact Check Tools API ─────────────────────────────────────
# # Required for Module 13 (fact verification).
# # Enable the API at: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
# GOOGLE_FACT_CHECK_API_KEY=

# # ─── Cloudinary (Media Upload) ───────────────────────────────────────
# # Required for Module 9 (image/video/audio upload to Cloudinary).
# # Sign up at: https://console.cloudinary.com/
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# # ─── Python AI Service ───────────────────────────────────────────────
# # URL of the Python FastAPI engine for text/video/audio analysis.
# # Leave at the default to use local development server.
# # Set to empty string to skip AI analysis (pipeline uses fallback defaults).
# AI_SERVICE_URL=http://127.0.0.1:8000

# # ─── Age Verification (Module 18) ───────────────────────────────────
# # Provider selection: "mock" (default), or a real provider name.
# AGE_VERIFICATION_PROVIDER=mock

# # Mock provider tuning (development only):
# # AGE_VERIFICATION_MOCK_UNAVAILABLE=true    # Simulate provider outage
# # AGE_VERIFICATION_MOCK_FAIL_FOR=user1,user2  # Fail for specific users
# # AGE_VERIFICATION_MOCK_REVIEW_FOR=user3   # Force REQUIRES_REVIEW
# # AGE_VERIFICATION_MOCK_DEFAULT_CATEGORY=ADULT  # Default age category
# # AGE_VERIFICATION_MOCK_LATENCY_MS=500     # Simulate network latency



PORT=5000
NODE_ENV=development

CORS_ORIGIN=http://localhost:3000,http://localhost:5000

MONGO_URI=mongodb://localhost:27017/nexora

FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_PROJECT_ID=nexora-dev

JWT_SECRET=change-me-to-a-random-string

GOOGLE_FACT_CHECK_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AI_SERVICE_URL=http://127.0.0.1:8000

AGE_VERIFICATION_PROVIDER=mock