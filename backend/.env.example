PORT=5000
NODE_ENV=development

CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://localhost:50775

MONGO_URI=mongodb+srv://YOUR_MONGODB_URI_HERE

FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key":"-----YOUR_PRIVATE_KEY-----","client_email":"your-service-account@your-project.iam.gserviceaccount.com"}
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID

JWT_SECRET=YOUR_JWT_SECRET_HERE

# Google Fact Check Tools API key
# Get from: https://developers.google.com/fact-check/tools/api-key
GOOGLE_FACT_CHECK_API_KEY=YOUR_KEY_HERE

# Google Gemini API key
# Get from: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=YOUR_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Google Cloud media APIs (Cloud Video Intelligence + Cloud Speech-to-Text)
# ---------------------------------------------------------------------------
# These are required ONLY for video/audio analysis. When they are not
# configured, the corresponding signals are reported as UNAVAILABLE and no
# substitute (heuristic or invented) result is produced for them.
#
# Enable in the Google Cloud project:
#   - Cloud Video Intelligence API
#   - Cloud Speech-to-Text API
#   - Cloud Storage API (only if GOOGLE_CLOUD_STORAGE_BUCKET is used)
#
# Path to a service-account JSON file (backend-only, never commit it):
GOOGLE_APPLICATION_CREDENTIALS=
# ...or provide the service-account JSON inline instead of the file path:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Project id that has the required APIs enabled:
GOOGLE_CLOUD_PROJECT_ID=
# Optional: bucket used for media that must be referenced by a gs:// URI
# (audio > 10MB, video > 20MB).
GOOGLE_CLOUD_STORAGE_BUCKET=

# AI Service URL (Python backend for Hugging Face models)
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional fine-tuned Nexora model directories (Python AI service).
# When unset, the service reports the fallback it actually used — it never
# fabricates a model result.
# NEXORA_MISINFO_MODEL=./src/ai_service/training/models/nexora-text-v1
# NEXORA_CLAIM_MODEL=./src/ai_service/training/models/nexora-claim-v1
# NEXORA_IMAGE_MODEL=./src/ai_service/training/models/nexora-image-v1
# NEXORA_AUDIO_MODEL=./src/ai_service/training/models/nexora-audio-v1
# NEXORA_VIDEO_MODEL=./src/ai_service/training/models/nexora-video-v1

# Age verification provider (mock | real)
AGE_VERIFICATION_PROVIDER=mock
