# # ╔══════════════════════════════════════════════════════════════════════╗
# # ║  Nexora Backend — Environment Variables                            ║
# # ║  Copy this file to .env and fill in the values.                    ║
# # ╚══════════════════════════════════════════════════════════════════════╝

# # ─── Server ───────────────────────────────────────────────────────────
# PORT=5000
# NODE_ENV=development

# # Comma-separated origins allowed by CORS (use * to allow all)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# # ─── Database ─────────────────────────────────────────────────────────
# # MongoDB connection string (local or Atlas)
# MONGO_URI=mongodb://localhost:27017/nexora
# # MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/nexora

# # ─── Authentication ───────────────────────────────────────────────────
# # Firebase Admin SDK — at least one credential source is required for
# # the v1 API (/api/v1/auth/*). Without it, Firebase init falls back to
# # demo/emulator mode and token verification will fail.

# # Option 1: Full service-account JSON string (single line, no newlines)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# # Option 2: Path to a service-account JSON key file
# # GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# # Firebase project ID (used in demo mode when no credentials are set)
# FIREBASE_PROJECT_ID=nexora-dev

# # Legacy JWT secret — used by /api/auth/* routes (legacy auth controller)
# # Only needed if clients still use the legacy JWT-based auth endpoints.
# JWT_SECRET=change-me-to-a-random-string

# # ─── Google Fact Check Tools API ─────────────────────────────────────
# # Required for Module 13 (fact verification).
# # Enable the API at: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
# GOOGLE_FACT_CHECK_API_KEY=

# # ─── Cloudinary (Media Upload) ───────────────────────────────────────
# # Required for Module 9 (image/video/audio upload to Cloudinary).
# # Sign up at: https://console.cloudinary.com/
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# # ─── Python AI Service ───────────────────────────────────────────────
# # URL of the Python FastAPI engine for text/video/audio analysis.
# # Leave at the default to use local development server.
# # Set to empty string to skip AI analysis (pipeline uses fallback defaults).
# AI_SERVICE_URL=http://127.0.0.1:8000

# # Optional: directory of a fine-tuned misinformation classifier produced
# # by training/train.py (backend/src/ai_service/training). When unset the
# # AI service falls back to zero-shot classification and says so in the
# # response.
# NEXORA_MISINFO_MODEL=training/models/nexora-fakenews-distilbert

# # ─── Age Verification (Module 18) ───────────────────────────────────
# # Provider selection: "mock" (default), or a real provider name.
# AGE_VERIFICATION_PROVIDER=mock

# # Mock provider tuning (development only):
# # AGE_VERIFICATION_MOCK_UNAVAILABLE=true    # Simulate provider outage
# # AGE_VERIFICATION_MOCK_FAIL_FOR=user1,user2  # Fail for specific users
# # AGE_VERIFICATION_MOCK_REVIEW_FOR=user3   # Force REQUIRES_REVIEW
# # AGE_VERIFICATION_MOCK_DEFAULT_CATEGORY=ADULT  # Default age category
# # AGE_VERIFICATION_MOCK_LATENCY_MS=500     # Simulate network latency



PORT=5000
NODE_ENV=development

CORS_ORIGIN=http://localhost:3000,http://localhost:5000

MONGO_URI=mongodb://localhost:27017/nexora

FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_PROJECT_ID=nexora-dev

JWT_SECRET=change-me-to-a-random-string

GOOGLE_FACT_CHECK_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AI_SERVICE_URL=http://127.0.0.1:8000

# Optional: fine-tuned models produced by training/train.py --task <task>.
# Each is loaded lazily; when unset or unloadable the AI service falls back
# to its built-in analysis and reports the fallback — never fabricated.
# NEXORA_IMAGE_MODEL=training/models/nexora-image-ai-detector
# NEXORA_AUDIO_MODEL=training/models/nexora-audio-synthetic-detector
# NEXORA_VIDEO_MODEL=training/models/nexora-video-manipulation-detector
# NEXORA_CLAIM_MODEL=training/models/nexora-text-classifier   # FEVER claim verification

# ─── Age Assurance (Module 18) ────────────────────────────────────────
# Privacy-preserving age assurance. Nexora stores ONLY the result (status +
# age band), never DOB, government IDs, documents or biometrics.
#
# Provider selection:
#   - Unset in development          → "mock" (test provider) is used.
#   - "mock" + NODE_ENV=production  → server REFUSES TO START unless
#     AGE_VERIFICATION_TEST_MODE=true (explicit, never for real users).
#   - Real provider name (production): add the provider class to
#     src/services/age-verification/ and the provider's own env vars here
#     (e.g. AGE_ASSURANCE_API_KEY, AGE_ASSURANCE_SECRET). Unknown names
#     fail loudly — there is no silent fallback to the mock provider.
AGE_VERIFICATION_PROVIDER=mock

# Explicit opt-in to the mock provider in production (never for real users).
# AGE_VERIFICATION_TEST_MODE=true

# Mock (test) provider tuning — development ONLY:
# AGE_VERIFICATION_MOCK_UNAVAILABLE=true        # Simulate provider outage
# AGE_VERIFICATION_MOCK_FAIL_FOR=user1,user2    # Fail for specific users
# AGE_VERIFICATION_MOCK_REVIEW_FOR=user3        # Force REQUIRES_REVIEW
# AGE_VERIFICATION_MOCK_DEFAULT_CATEGORY=ADULT  # Result age band (ADULT|TEEN|MINOR|UNKNOWN)
# AGE_VERIFICATION_MOCK_LATENCY_MS=0            # Simulate provider latency